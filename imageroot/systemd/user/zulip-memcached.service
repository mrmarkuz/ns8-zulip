[Unit]
Description=Podman  zulip-memcached.service
BindsTo=zulip.service
After=zulip.service postgresql-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/smarthost.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/zulip-memcached.pid %t/zulip-memcached.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/zulip-memcached.pid \
    --cidfile %t/zulip-memcached.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/zulip.pod-id --replace -d --name  zulip-memcached \
    --env SASL_CONF_PATH=/home/memcache/memcached.conf \
    --env MEMCACHED_SASL_PWDB=/home/memcache/memcached-sasl-db \
    --env MEMCACHED_PASSWORD=zulip \
    ${MEMCACHED_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/zulip-memcached.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP zulip-memcached
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/zulip-memcached.ctr-id
PIDFile=%t/zulip-memcached.pid
Type=forking

[Install]
WantedBy=default.target
